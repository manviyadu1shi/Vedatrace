# Free default: Google Gemini through the OpenAI-compatible provider (key from aistudio.google.com/apikey). Never commit a real key.
VEDATRACE_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.1-flash-lite
# Memory (Graphiti + case store) on the same free Gemini key:
OPENAI_EMBED_MODEL=gemini-embedding-001
VEDATRACE_MEMORY=auto

# Alternatives (set VEDATRACE_LLM_PROVIDER accordingly):
#   anthropic: VEDATRACE_API_KEY=            (model claude-sonnet-5-5; implemented, not yet run against the live API)
#   ollama:    OLLAMA_HOST=http://localhost:11434   OLLAMA_MODEL=qwen2.5:14b   (local, free, slow on 16 GB)
#   OpenAI:    leave OPENAI_BASE_URL empty and set OPENAI_MODEL=<an OpenAI model>
VEDATRACE_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OPENAI_GRAPHITI_MODEL=gpt-4.1-mini
